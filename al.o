Elf64_Ehdr *ts = (Elf64_Ehdr *)res;

    Elf64_Shdr *section_headers = (Elf64_Shdr *)((char *)res + ts->e_shoff);
    Elf64_Shdr *symtab = NULL;
    Elf64_Shdr *strtab = NULL;
    for (int i = 0; i < ts->e_shnum; i++) {
        if (section_headers[i].sh_type == SHT_SYMTAB) {
            symtab = &section_headers[i];
        } else if (section_headers[i].sh_type == SHT_STRTAB && i != ts->e_shstrndx) {
            strtab = &section_headers[i];
        }
    }

     if (!symtab || !strtab) {
        printf("Symbol table or string table not found\n");
        munmap(res, file_size);
        return NULL;
    }

    // Access symbols
    Elf64_Sym *symbols = (Elf64_Sym *)((char *)res + symtab->sh_offset);
    int num_symbols = symtab->sh_size / symtab->sh_entsize;

    // Access string table
    const char *strtab_data = (const char *)res + strtab->sh_offset;

    // Print symbols
    for (int i = 0; i < num_symbols; i++) {
        printf("Symbol: %s, Value: 0x%llx, Size: %llu\n",
               &strtab_data[symbols[i].st_name],
               symbols[i].st_value,
               symbols[i].st_size);
    }



